# --- База данных ---
DATABASE_DSN=postgres://meetnotes:meetnotes@localhost:5433/meetnotes?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_CONNECT_TIMEOUT=5s

# --- Пользователь по умолчанию для CLI (можно переопределить флагом --user) ---
MEETNOTES_USER=

# --- Хранилище загруженных файлов ---
STORAGE_DIR=./data/uploads

# --- Логирование: debug | info | warn | error; формат: json | text ---
LOG_LEVEL=info
LOG_FORMAT=text

# --- Клиент распознавания речи: mock | yandex_speech | salute_speech ---
SPEECH_PROVIDER=mock
SPEECH_TIMEOUT=30s
SPEECH_MOCK_DIR=./testdata/transcripts
SPEECH_MOCK_DELAY=2s

# --- LLM-клиент: mock | gigachat ---
LLM_PROVIDER=mock
LLM_TIMEOUT=30s
LLM_MOCK_DELAY=1s

# --- Фоновая обработка ---
WORKER_CONCURRENCY=3
WORKER_POLL_INTERVAL=2s
WORKER_BATCH_SIZE=5
WORKER_LEASE_TTL=5m
WORKER_MAX_ATTEMPTS=3
JOB_TIMEOUT=2m
SHUTDOWN_TIMEOUT=15s

# --- Таймаут одной CLI-команды ---
COMMAND_TIMEOUT=30s
